+// EXPERIMENT: generate() re-downloads and re-parses every URL font on each call; give it the bytes,
+// fetched once per page. The UI keeps the URLs.
+let generatorFontsPromise: Promise<Font> | null = null;
+const getGeneratorFonts = (): Promise<Font> => {
+  if (!generatorFontsPromise) {
+    generatorFontsPromise = getFontsData().then(async (font) => {
+      const entries = await Promise.all(
+        Object.entries(font).map(async ([name, f]) => {
+          if (typeof f.data !== 'string') return [name, f] as const;
+          const data = new Uint8Array(await (await fetch(f.data)).arrayBuffer());
+          return [name, { ...f, data }] as const;
+        }),
+      );
+      return Object.fromEntries(entries) as Font;
+    });
+    generatorFontsPromise.catch(() => {
+      generatorFontsPromise = null;
+    });
+  }
+  return generatorFontsPromise;
+};
 
