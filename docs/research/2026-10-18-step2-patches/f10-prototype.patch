diff --git a/packages/ui/src/components/Designer/useDetailLayer.ts b/packages/ui/src/components/Designer/useDetailLayer.ts
new file mode 100644
--- /dev/null
+++ b/packages/ui/src/components/Designer/useDetailLayer.ts
@@ -0,0 +1,292 @@
+import { MutableRefObject, RefObject, useEffect, useRef } from 'react';
+import {
+  BasePdf,
+  Size,
+  ZOOM,
+  b64toUint8Array,
+  getB64BasePdf,
+  isBlankPdf,
+  pt2mm,
+} from '@pdfme/common';
+import { createPdfDetailRenderer } from '@pdfme/converter';
+import type { PdfDetailRenderer, DetailRenderTask } from '@pdfme/converter';
+
+/**
+ * F10 high-zoom detail layer (docs/research/2026-10-17-designer-crash-study.md, F10).
+ *
+ * The page background stays the unchanged scale-`maxZoom` bitmap. When the zoom asks for more
+ * device pixels per PDF point than that bitmap has, the visible part of each page is rendered
+ * again at exactly 1 device pixel per canvas pixel into a canvas that lies inside the page div,
+ * under the schemas (pointer-events: none). It is refreshed SETTLE_MS after the last
+ * scroll/zoom/resize, superseded renders are cancelled, and the document is destroyed when
+ * basePdf changes or the Designer unmounts. Until a refresh lands, the user sees the base bitmap
+ * (or the previous detail canvas, still aligned), so nothing is ever blurrier than without it.
+ */
+
+// PDF point -> paper CSS px at scale 1, with the same constants that size the Paper and stretch the
+// background (pdf2size -> pt2mm, then * ZOOM): 0.3528 * 3.7795275591 = 1.33342, not exactly 4/3.
+const PX_PER_PT = pt2mm(1) * ZOOM;
+// Quiet time after the last scroll/zoom/resize before the visible region is re-rendered.
+const SETTLE_MS = 100;
+
+// TODO(f10-prototype): runtime knobs for the measurements; remove before shipping.
+type F10Knobs = { enabled?: boolean; useWorker?: boolean; settleMs?: number; hint?: boolean };
+const knobs = (): F10Knobs =>
+  (typeof window !== 'undefined' &&
+    (window as unknown as { __PDFME_F10__?: F10Knobs }).__PDFME_F10__) ||
+  {};
+
+type Rect = { left: number; top: number; right: number; bottom: number };
+type Placed = {
+  canvas: HTMLCanvasElement;
+  layer: HTMLDivElement;
+  scale: number;
+  dpr: number;
+  rel: Rect;
+};
+type Job = { scale: number; dpr: number; rel: Rect; w: number; h: number; devPerPt: number };
+
+const releaseCanvas = (canvas: HTMLCanvasElement) => {
+  canvas.remove();
+  // Free the backing store now instead of at the next GC.
+  canvas.width = 0;
+  canvas.height = 0;
+};
+
+const covers = (outer: Rect, inner: Rect) =>
+  outer.left <= inner.left + 0.01 &&
+  outer.top <= inner.top + 0.01 &&
+  outer.right >= inner.right - 0.01 &&
+  outer.bottom >= inner.bottom - 0.01;
+
+const isWhole = (v: number) => Math.abs(v - Math.round(v)) < 0.02;
+
+export const useDetailLayer = ({
+  basePdf,
+  scrollRef,
+  paperRefs,
+  layerRefs,
+  scale,
+  pageSizes,
+  baseRasterScale,
+}: {
+  basePdf: BasePdf;
+  scrollRef: RefObject<HTMLDivElement>;
+  paperRefs: MutableRefObject<HTMLDivElement[]>;
+  layerRefs: MutableRefObject<HTMLDivElement[]>;
+  /** Current Paper transform scale (fit scale x zoom level). */
+  scale: number;
+  /** From useUIPreProcessor: a new array after every (re)rasterization of the background. */
+  pageSizes: Size[];
+  /** Device px per PDF point of the background bitmap (= maxZoom / 100, see useUIPreProcessor). */
+  baseRasterScale: number;
+}) => {
+  const renderer = useRef<PdfDetailRenderer | null>(null);
+  const placed = useRef<(Placed | null)[]>([]);
+  const inflight = useRef<({ task: DetailRenderTask } | null)[]>([]);
+  const timer = useRef<ReturnType<typeof setTimeout> | null>(null);
+  const pageCount = pageSizes.length;
+  const live = useRef({ scale, pageCount, baseRasterScale });
+  live.current = { scale, pageCount, baseRasterScale };
+
+  const cancelPage = (i: number) => {
+    const f = inflight.current[i];
+    if (!f) return;
+    inflight.current[i] = null;
+    f.task.cancel(); // its canvas is released when the task's promise settles
+  };
+  const clearPage = (i: number) => {
+    cancelPage(i);
+    const p = placed.current[i];
+    if (p) releaseCanvas(p.canvas);
+    placed.current[i] = null;
+  };
+  const clearAll = () => {
+    if (timer.current) clearTimeout(timer.current);
+    timer.current = null;
+    const n = Math.max(placed.current.length, inflight.current.length);
+    for (let i = 0; i < n; i++) clearPage(i);
+    const paperOuter = paperRefs.current[0]?.parentElement;
+    if (paperOuter) paperOuter.style.willChange = '';
+  };
+
+  const startRender = (i: number, r: PdfDetailRenderer, job: Job) => {
+    cancelPage(i);
+    const canvas = document.createElement('canvas');
+    canvas.width = job.w;
+    canvas.height = job.h;
+    const t0 = performance.now();
+    const task = r.render({
+      pageIndex: i,
+      canvas,
+      scale: job.devPerPt,
+      offsetX: -job.rel.left,
+      offsetY: -job.rel.top,
+    });
+    const entry = { task };
+    inflight.current[i] = entry;
+    task.promise.then(
+      () => {
+        if (inflight.current[i] !== entry || renderer.current !== r) return releaseCanvas(canvas);
+        inflight.current[i] = null;
+        const layer = layerRefs.current[i];
+        if (!layer || !layer.isConnected) return releaseCanvas(canvas);
+        const k = job.dpr * job.scale; // device px per paper CSS px
+        // Size in screen CSS px and undo the Paper's scale(s) with a transform: CSS lengths are
+        // snapped to 1/64 px by layout (a paper-px width like 199.067px would composite the canvas
+        // at 0.99998x, i.e. resampled and visibly blurred), transforms are not.
+        Object.assign(canvas.style, {
+          position: 'absolute',
+          left: '0px',
+          top: '0px',
+          width: `${job.w / job.dpr}px`,
+          height: `${job.h / job.dpr}px`,
+          transformOrigin: '0 0',
+          transform: `translate(${job.rel.left / k}px, ${job.rel.top / k}px) scale(${1 / job.scale})`,
+          pointerEvents: 'none',
+        });
+        canvas.setAttribute('data-pdfme-detail', '');
+        layer.appendChild(canvas);
+        const old = placed.current[i];
+        if (old) releaseCanvas(old.canvas);
+        placed.current[i] = { canvas, layer, scale: job.scale, dpr: job.dpr, rel: job.rel };
+        // TODO(f10-prototype): measurement hook.
+        performance.measure('pdfme-f10-render', {
+          start: t0,
+          end: performance.now(),
+          detail: { page: i, w: job.w, h: job.h, worker: r.usesWorker },
+        });
+      },
+      () => {
+        // Cancelled or failed: the base bitmap (or the previous detail canvas) stays visible.
+        if (inflight.current[i] === entry) inflight.current[i] = null;
+        releaseCanvas(canvas);
+      },
+    );
+  };
+
+  const update = () => {
+    timer.current = null;
+    const r = renderer.current;
+    const scroller = scrollRef.current;
+    if (!r || !scroller) return;
+    const { scale: s, pageCount: n, baseRasterScale: base } = live.current;
+    const dpr = window.devicePixelRatio || 1;
+    const devPerPt = PX_PER_PT * s * dpr;
+    const needed = devPerPt > base * 1.001;
+    // Chrome 155 resamples a canvas inside the non-composited scale(s) container unless that
+    // container is its own compositing layer (measured: 1-px stripes blur at s=5.36, exact with this
+    // hint; Chrome 134 is exact either way). Only set while the detail layer is active, so that below
+    // the threshold nothing changes compared with today. TODO(f10-detail-layer): a Paper prop instead.
+    const paperOuter = paperRefs.current[0]?.parentElement;
+    if (paperOuter)
+      paperOuter.style.willChange = needed && knobs().hint !== false ? 'transform' : '';
+    const sr = scroller.getBoundingClientRect();
+    const clip: Rect = {
+      left: Math.max(0, sr.left + scroller.clientLeft),
+      top: Math.max(0, sr.top + scroller.clientTop),
+      right: Math.min(window.innerWidth, sr.left + scroller.clientLeft + scroller.clientWidth),
+      bottom: Math.min(window.innerHeight, sr.top + scroller.clientTop + scroller.clientHeight),
+    };
+    for (let i = 0; i < Math.min(n, r.numPages); i++) {
+      const pageEl = paperRefs.current[i];
+      if (!needed || !pageEl || !pageEl.isConnected || !layerRefs.current[i]) {
+        clearPage(i);
+        continue;
+      }
+      const pr = pageEl.getBoundingClientRect();
+      const vis: Rect = {
+        left: Math.max(pr.left, clip.left),
+        top: Math.max(pr.top, clip.top),
+        right: Math.min(pr.right, clip.right),
+        bottom: Math.min(pr.bottom, clip.bottom),
+      };
+      if (vis.right - vis.left < 1 || vis.bottom - vis.top < 1) {
+        clearPage(i);
+        continue;
+      }
+      // Snap the canvas to whole device pixels so that it is composited 1:1.
+      const pox = pr.left * dpr;
+      const poy = pr.top * dpr;
+      const dl = Math.floor(vis.left * dpr);
+      const dt = Math.floor(vis.top * dpr);
+      const dr = Math.ceil(vis.right * dpr);
+      const db = Math.ceil(vis.bottom * dpr);
+      const rel: Rect = { left: dl - pox, top: dt - poy, right: dr - pox, bottom: db - poy };
+      const p = placed.current[i];
+      if (
+        p &&
+        !inflight.current[i] &&
+        p.layer === layerRefs.current[i] &&
+        p.canvas.isConnected &&
+        p.scale === s &&
+        p.dpr === dpr &&
+        covers(p.rel, rel) &&
+        isWhole(pox + p.rel.left) &&
+        isWhole(poy + p.rel.top)
+      ) {
+        continue; // the current detail canvas still covers the view, 1:1
+      }
+      startRender(i, r, { scale: s, dpr, rel, w: dr - dl, h: db - dt, devPerPt });
+    }
+    for (let i = Math.min(n, r.numPages); i < placed.current.length; i++) clearPage(i);
+  };
+
+  const schedule = () => {
+    // Free the main thread while the user is scrolling/zooming: cancel what is in flight.
+    for (let i = 0; i < inflight.current.length; i++) cancelPage(i);
+    if (timer.current) clearTimeout(timer.current);
+    timer.current = setTimeout(update, knobs().settleMs ?? SETTLE_MS);
+  };
+
+  // One pdf.js document per basePdf, destroyed on change/unmount.
+  useEffect(() => {
+    clearAll();
+    if (knobs().enabled === false || isBlankPdf(basePdf)) return;
+    let cancelled = false;
+    let opened: PdfDetailRenderer | null = null;
+    void (async () => {
+      const t0 = performance.now();
+      const bytes = b64toUint8Array(await getB64BasePdf(basePdf));
+      if (cancelled) return;
+      opened = await createPdfDetailRenderer(bytes, { useWorker: knobs().useWorker !== false });
+      if (cancelled) {
+        void opened.destroy();
+        return;
+      }
+      renderer.current = opened;
+      performance.measure('pdfme-f10-open', { start: t0, end: performance.now() });
+      schedule();
+    })().catch((e) => console.warn('[@pdfme/ui] detail layer disabled:', e));
+    return () => {
+      cancelled = true;
+      clearAll();
+      if (opened) void opened.destroy();
+      if (renderer.current === opened) renderer.current = null;
+    };
+  }, [basePdf]);
+
+  // Re-evaluate after zoom (scale) changes and after the background was (re)rasterized (the Paper
+  // may have re-created its page divs) ...
+  useEffect(() => {
+    if (renderer.current) schedule();
+  }, [scale, pageSizes, baseRasterScale]);
+
+  // ... and after scrolling or resizing.
+  useEffect(() => {
+    const scroller = scrollRef.current;
+    if (!scroller) return;
+    const onChange = () => {
+      if (renderer.current) schedule();
+    };
+    scroller.addEventListener('scroll', onChange, { passive: true });
+    window.addEventListener('resize', onChange);
+    const ro = typeof ResizeObserver !== 'undefined' ? new ResizeObserver(onChange) : null;
+    ro?.observe(scroller);
+    return () => {
+      scroller.removeEventListener('scroll', onChange);
+      window.removeEventListener('resize', onChange);
+      ro?.disconnect();
+    };
+  }, [scrollRef.current]);
+};
