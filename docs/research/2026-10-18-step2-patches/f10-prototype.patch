@@ -0,0 +1,99 @@
+import * as pdfjsLib from 'pdfjs-dist';
+import type { PDFDocumentProxy, PDFPageProxy, RenderTask } from 'pdfjs-dist';
+import type { PdfDetailRenderer } from './detailRenderer.types.js';
+// The pdf.js worker as source text. It is turned into a same-origin Blob URL at runtime, so the
+// @pdfme/ui library build ships no separate worker file. TODO(f10-detail-layer): +1.1 MB of bundle;
+// the base raster (pdf2img/pdf2size) keeps using the main-thread fake worker of index.browser.ts.
+import pdfWorkerSource from 'pdfjs-dist/build/pdf.worker.min.js?raw';
+
+let workerUrl: string | null = null;
+const getWorkerUrl = () => {
+  if (!workerUrl) {
+    workerUrl = URL.createObjectURL(new Blob([pdfWorkerSource], { type: 'text/javascript' }));
+  }
+  return workerUrl;
+};
+
+export const createPdfDetailRenderer = async (
+  pdf: ArrayBuffer | Uint8Array,
+  options: { useWorker?: boolean } = {},
+): Promise<PdfDetailRenderer> => {
+  const { useWorker = true } = options;
+  let webWorker: Worker | null = null;
+  let pdfWorker: pdfjsLib.PDFWorker | null = null;
+  if (useWorker && typeof Worker !== 'undefined') {
+    try {
+      webWorker = new Worker(getWorkerUrl());
+      // pdfjs-dist 3.11 types declare `port` as null; a Worker is what pdf.js expects.
+      pdfWorker = new pdfjsLib.PDFWorker({ port: webWorker as unknown as null });
+    } catch (e) {
+      console.warn('[@pdfme/converter] detail renderer: no Web Worker, using the main thread', e);
+      webWorker?.terminate();
+      webWorker = null;
+      pdfWorker = null;
+    }
+  }
+  const releaseWorker = () => {
+    pdfWorker?.destroy();
+    webWorker?.terminate();
+    pdfWorker = null;
+    webWorker = null;
+  };
+
+  const loadingTask = pdfjsLib.getDocument({
+    data: pdf,
+    isEvalSupported: false,
+    ...(pdfWorker ? { worker: pdfWorker } : {}),
+  });
+  let doc: PDFDocumentProxy;
+  try {
+    doc = await loadingTask.promise;
+  } catch (e) {
+    releaseWorker();
+    throw e;
+  }
+
+  let destroyed = false;
+  const pages = new Map<number, Promise<PDFPageProxy>>();
+  const getPage = (pageIndex: number) => {
+    let p = pages.get(pageIndex);
+    if (!p) {
+      p = doc.getPage(pageIndex + 1);
+      pages.set(pageIndex, p);
+    }
+    return p;
+  };
+
+  return {
+    numPages: doc.numPages,
+    usesWorker: !!pdfWorker,
+    render: ({ pageIndex, canvas, scale, offsetX, offsetY }) => {
+      let task: RenderTask | null = null;
+      let cancelled = false;
+      const promise = (async () => {
+        const page = await getPage(pageIndex);
+        if (cancelled || destroyed) throw new Error('cancelled');
+        const viewport = page.getViewport({ scale, offsetX, offsetY });
+        const canvasContext = canvas.getContext('2d') as CanvasRenderingContext2D;
+        task = page.render({ canvasContext, viewport });
+        await task.promise;
+      })();
+      return {
+        promise,
+        cancel: () => {
+          cancelled = true;
+          task?.cancel();
+        },
+      };
+    },
+    destroy: async () => {
+      if (destroyed) return;
+      destroyed = true;
+      try {
+        await loadingTask.destroy();
+      } finally {
+        releaseWorker();
+      }
+    },
+  };
+};
diff --git a/packages/converter/src/detailRenderer.types.ts b/packages/converter/src/detailRenderer.types.ts
new file mode 100644
--- /dev/null
+++ b/packages/converter/src/detailRenderer.types.ts
@@ -0,0 +1,28 @@
+export interface DetailRenderArg {
+  /** 0-based page index. */
+  pageIndex: number;
+  /** Target canvas; its width/height (device px) are set by the caller. */
+  canvas: HTMLCanvasElement;
+  /** Device pixels per PDF point. */
+  scale: number;
+  /** Position of the page's top-left corner in canvas pixels (usually <= 0). */
+  offsetX: number;
+  offsetY: number;
+}
+
+export interface DetailRenderTask {
+  promise: Promise<void>;
+  cancel: () => void;
+}
+
+/**
+ * One pdf.js document kept alive for repeated region renders (the Designer's high-zoom detail
+ * layer). Parsing runs in a real Web Worker when available; painting runs on the main thread in
+ * pdf.js' own ~15 ms requestAnimationFrame slices.
+ */
+export interface PdfDetailRenderer {
+  readonly numPages: number;
+  readonly usesWorker: boolean;
+  render: (arg: DetailRenderArg) => DetailRenderTask;
+  destroy: () => Promise<void>;
+}
